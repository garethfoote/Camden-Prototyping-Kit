{% extends "layouts/main.njk" %}
{% from "macros/forms.njk" import errorSummary, textInput %}
{% from "event-equipment/_macros.njk" import fieldError %}
{% from "components/button/macro.njk" import LBCamdenButton %}
{% set pageTitle = "Collecting your equipment" %}
{% block beforeContent %}<div class="govuk-width-container">
<a class="govuk-back-link" href="/event-equipment/fulfilment">Back</a>
</div>{% endblock %}
{% block content %}<div class="govuk-width-container">
<div class="govuk-grid-row">
<div class="govuk-grid-column-two-thirds">
{{ errorSummary(errorList) }}
<h1 class="govuk-heading-xl">Collecting your equipment</h1>
<form action="/event-equipment/collection" method="post" novalidate>
<p class="govuk-body">Collect your equipment from the example community centre. We will confirm the collection time after reviewing your request.</p>
{{ LBCamdenButton({text: "Continue", preventDoubleClick: true}) }}
</form>
</div>
</div>
</div>{% endblock %}
